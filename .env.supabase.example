# Django API
DJANGO_SECRET_KEY=replace-with-at-least-32-random-bytes
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
API_DOCS_PUBLIC=false

# Supabase Database > Connect > Session pooler.
# URL-encode special characters in the password before inserting it into this URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MODE=session
DB_CONN_MAX_AGE=60
DB_SSL_MODE=require
# Django tables live outside the Supabase Data API's public schema.
DB_SEARCH_PATH=hoopmap,extensions,gis,public
API_NUM_PROXIES=1

# Redis is still required by Celery and the application cache.
REDIS_URL=rediss://default:REDIS_PASSWORD@REDIS_HOST:REDIS_PORT/0

# Supabase Storage > Configuration > S3 Access Keys.
# These credentials bypass Storage RLS and must exist only on the backend.
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=SUPABASE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=SUPABASE_S3_SECRET_ACCESS_KEY
S3_BUCKET_NAME=hoopmap-media
S3_REGION_NAME=SUPABASE_PROJECT_REGION
S3_USE_SSL=true
S3_ADDRESSING_STYLE=path
S3_CUSTOM_DOMAIN=PROJECT_REF.supabase.co/storage/v1/object/public/hoopmap-media

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
TELEGRAM_WEBAPP_URL=https://app.example.com
INTERNAL_API_TOKEN=replace-with-a-different-long-random-value
BACKEND_API_URL=https://api.example.com/api/v1
JWT_AUDIENCE=hoopmap-client
JWT_ISSUER=https://api.example.com
AUTH_REFRESH_COOKIE_NAME=hoopmap_refresh
AUTH_COOKIE_SECURE=true
# Lax works for app.example.com + api.example.com. Use None only for unrelated HTTPS domains.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=.example.com

# Vercel frontend
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MEDIA_HOST=PROJECT_REF.supabase.co
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
CSP_CONNECT_SRC=

# Used only when explicitly loading demo data.
SEED_ADMIN_PASSWORD=replace-before-running-seed
