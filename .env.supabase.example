# Serverless HOOPMAP: use these values in Vercel, with Root Directory = frontend.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=hoopmap-media
SUPABASE_STORAGE_BUCKET=hoopmap-media

NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MEDIA_HOST=PROJECT_REF.supabase.co
CSP_CONNECT_SRC=https://tiles.openfreemap.org

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
TELEGRAM_WEBAPP_URL=https://YOUR_PROJECT.vercel.app

AUTH_REFRESH_COOKIE_NAME=hoopmap_refresh
RATE_LIMIT_SECRET=replace-with-a-different-long-random-value
